{
    "name": "acme-widget-co/sales-system",
    "description": "POC for Acme Widget Co sales system",
    "require": {
        "php": "^8.3",
        "psr/container": "^2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5",
        "phpstan/phpstan": "^1.9"
    },
    "autoload": {
        "psr-4": {
            "Acme\\WidgetCo\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Acme\\WidgetCo\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "stan": "vendor/bin/phpstan analyse src tests"
    }
}